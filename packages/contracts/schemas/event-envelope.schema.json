{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/shared-agentic-va/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "session_id",
    "extension_id",
    "aggregate_id",
    "aggregate_version",
    "actor",
    "event_type",
    "payload",
    "correlation_id",
    "recorded_at"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "extension_id": {"type": "string", "minLength": 1},
    "aggregate_id": {"type": "string", "minLength": 1},
    "aggregate_version": {"type": "integer", "minimum": 0},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["human", "agent", "system", "tool"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "event_type": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
